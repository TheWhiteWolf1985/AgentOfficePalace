[Unit]
Description=Agent Office Palace application
After=network.target

[Service]
Type=simple
User=agentoffice
Group=agentoffice
WorkingDirectory=/opt/agent-office-palace/source
Environment=HOME=/var/lib/agent-office-palace
Environment=PATH=/opt/node22/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/agent-office-palace.env
ExecStart=/opt/node22/bin/node /opt/agent-office-palace/source/bin/agent-office.js --home /var/lib/agent-office-palace/office --projects /var/lib/agent-office-palace/projects --host 0.0.0.0 --port 4600 --no-open
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
