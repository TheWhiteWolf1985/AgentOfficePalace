# Build from the repository root. The local VM111 base supplies Codex, Git and
# the existing production dependencies; credentials and runtime data stay out.
ARG BASE_IMAGE=agent-office:isolato
FROM ${BASE_IMAGE} AS dependencies
USER root
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM dependencies AS verified
COPY . .
# The size guard enumerates the source files through Git. A fresh index is
# sufficient: the corporate checkout and its credentials never enter the image.
RUN git init && git add src && npm run typecheck && npm test && npm run build

FROM ${BASE_IMAGE} AS application
USER root
WORKDIR /opt/agent-office
RUN rm -rf /opt/agent-office/src /opt/agent-office/dist
COPY --from=verified /build/src ./src
COPY --from=verified /build/dist ./dist
COPY --from=verified /build/bin ./bin
COPY --from=verified /build/package.json /build/package-lock.json ./
USER 1000:1000
